-- ============================================
-- БИНД НА DELETE
-- ============================================
local menuOpen = true
addConnection(UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Delete then
        menuOpen = not menuOpen
        pcall(function() if menuOpen then Rayfield:Open() else Rayfield:Close() end end)
    end
end))

-- ============================================
-- АВТО-СБРОС
-- ============================================
pcall(function()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local enterArena = remotes:FindFirstChild("EnterArena")
        if enterArena then addConnection(enterArena.OnClientEvent:Connect(function() resetKillAura() end)) end
    end
end)

addConnection(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    resetKillAura()
    if Settings.SelfEnabled then createSelfSpheres() end
    if Settings.PlayerGlow then updateWorldVisuals() end
end))

-- ============================================
-- ГЛАВНЫЙ ЦИКЛ
-- ============================================
addConnection(RunService.RenderStepped:Connect(function(dt)
    if Unloaded then return end
    updateESP()
    updateSelfSpheres(dt)
    killAuraStep()
    updateWorldVisuals()
end))

