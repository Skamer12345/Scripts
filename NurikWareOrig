local function safeDisconnect(conn)
    if conn and typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
end
local function addConnection(conn) table.insert(Connections, conn); return conn end
local function clearTable(t) for k in pairs(t) do t[k] = nil end end

-- ИСПРАВЛЕННЫЙ ПОИСК ПЕРСОНАЖА (Для дистанции и ESP)
local function getPlayerCharacter(player)
    if not player then return nil end
    
    -- 1. Стандартный Character
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then 
        return char 
    end
    
    -- 2. Поиск по имени игрока в Workspace (как на твоем скрине)
    local wsChar = workspace:FindFirstChild(player.Name)
    if wsChar and wsChar:FindFirstChild("HumanoidRootPart") then 
        return wsChar 
    end
    
    -- 3. Поиск любой Model с именем игрока
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == player.Name and obj:FindFirstChild("HumanoidRootPart") then
            return obj
        end
    end
    return nil
end

