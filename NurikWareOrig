local function removeESPFor(player)
    if CreatedHighlights[player] then
        pcall(function() CreatedHighlights[player]:Destroy() end)
        CreatedHighlights[player] = nil
    end
    local d = CreatedDrawings[player]
    if d then
        for _, obj in pairs(d) do
            if typeof(obj) == "table" then
                for _, line in ipairs(obj) do pcall(function() line:Remove() end) end
            else
                pcall(function() obj:Remove() end)
            end
        end
        CreatedDrawings[player] = nil
    end
end

local function getOrCreateDrawings(player)
    if CreatedDrawings[player] then return CreatedDrawings[player] end
    local d = {}
    d.box       = Drawing.new("Square")
    d.name      = Drawing.new("Text")
    d.healthBg  = Drawing.new("Square")
    d.health    = Drawing.new("Square")
    d.dist      = Drawing.new("Text")
    d.tracer    = Drawing.new("Line")
    d.snapLine  = Drawing.new("Line")
    d.weapon    = Drawing.new("Text")
    d.skeleton  = {}
    for i = 1, 15 do table.insert(d.skeleton, Drawing.new("Line")) end
    CreatedDrawings[player] = d
    return d
end

local function createHighlight(player, char)
    if player == LocalPlayer or not char then return end
    local hl = CreatedHighlights[player]
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "NurikWare_HL"
        hl.Parent = char
        hl.Adornee = char
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        CreatedHighlights[player] = hl
    end
    if Settings.ESPChamsMat == "Neon" then
        hl.FillColor = Settings.ESPColor; hl.FillTransparency = 0.4
    else
        hl.FillColor = Settings.ESPColor; hl.FillTransparency = 0.8
    end
    hl.OutlineColor = Settings.ESPColor
    hl.Enabled = Settings.ESPEnabled and Settings.ESPChams
end

local function getCharacterParts(char)
    local parts = {}
    for _, name in ipairs({
        "Head","UpperTorso","LowerTorso","Torso",
        "LeftUpperArm","LeftLowerArm","LeftHand",
        "RightUpperArm","RightLowerArm","RightHand",
        "LeftUpperLeg","LeftLowerLeg","LeftFoot",
        "RightUpperLeg","RightLowerLeg","RightFoot",
        "HumanoidRootPart"
    }) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then parts[name] = p end
    end
    return parts
end

local function drawSkeleton(d, char, color)
    local parts = getCharacterParts(char)
    local connections = {
        {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
    }
    for i, line in ipairs(d.skeleton) do
        local pair = connections[i]
        if pair then
            local a, b = parts[pair[1]], parts[pair[2]]
            if a and b then
                local sa, onA = Camera:WorldToViewportPoint(a.Position)
                local sb, onB = Camera:WorldToViewportPoint(b.Position)
                if onA and onB then
                    line.From = Vector2.new(sa.X, sa.Y); line.To = Vector2.new(sb.X, sb.Y)
                    line.Color = color; line.Thickness = 1; line.Visible = true
                else line.Visible = false end
            else line.Visible = false end
        else line.Visible = false end
    end
end

local function updateESP()
    if Unloaded then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getPlayerCharacter(player)
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            local isTeam = false
            if Settings.ESPTeamCheck and player.Team == LocalPlayer.Team then isTeam = true end

            if not (char and hrp and humanoid and humanoid.Health > 0) or isTeam then
                removeESPFor(player)
            else
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                if dist > Settings.ESPMaxDistance or not Settings.ESPEnabled then
                    local d = CreatedDrawings[player]
                    if d then
                        d.box.Visible = false; d.name.Visible = false; d.healthBg.Visible = false; d.health.Visible = false
                        d.dist.Visible = false; d.tracer.Visible = false; d.snapLine.Visible = false; d.weapon.Visible = false
                        for _, l in ipairs(d.skeleton) do l.Visible = false end
                    end
                    if CreatedHighlights[player] then CreatedHighlights[player].Enabled = false end
                else
                    if Settings.ESPChams then createHighlight(player, char)
                    else if CreatedHighlights[player] then CreatedHighlights[player].Enabled = false end end
                    
                    local d = getOrCreateDrawings(player)
                    local head = char:FindFirstChild("Head")
                    if head then
                        local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local rootPos  = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.5, 0))
                        
                        if onScreen and headPos.Z > 0 then
                            local height = math.abs(headPos.Y - rootPos.Y)
                            local width  = height / 2
                            
                            d.box.Size = Vector2.new(width, height)
                            d.box.Position = Vector2.new(headPos.X - width/2, headPos.Y)
                            d.box.Color = Settings.ESPColor; d.box.Thickness = 1; d.box.Filled = false
                            d.box.Visible = Settings.ESPBox

                            d.name.Text = player.Name
                            d.name.Position = Vector2.new(headPos.X, headPos.Y - 18)
                            d.name.Size = 14; d.name.Center = true; d.name.Outline = true
                            d.name.Color = Settings.ESPTextColor; d.name.Visible = Settings.ESPName

                            -- РАБОЧАЯ ДИСТАНЦИЯ
                            d.dist.Text = math.floor(dist) .. "m"
                            d.dist.Position = Vector2.new(headPos.X + width/2 + 5, headPos.Y + height/2)
                            d.dist.Size = 12; d.dist.Color = Settings.ESPTextColor
                            d.dist.Visible = Settings.ESPDistance

                            local hpPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            local hpColor = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0)
                            
                            d.healthBg.Size = Vector2.new(3, height)
                            d.healthBg.Position = Vector2.new(headPos.X - width/2 - 6, headPos.Y)
                            d.healthBg.Color = Color3.fromRGB(0, 0, 0); d.healthBg.Filled = true
                            d.healthBg.Visible = Settings.ESPHealth
                            
                            d.health.Size = Vector2.new(3, height * hpPct)
                            d.health.Position = Vector2.new(headPos.X - width/2 - 6, headPos.Y + height * (1 - hpPct))
                            d.health.Color = hpColor; d.health.Filled = true
                            d.health.Visible = Settings.ESPHealth

                            local screenSize = Camera.ViewportSize
                            d.tracer.From = Vector2.new(screenSize.X/2, screenSize.Y)
                            d.tracer.To   = Vector2.new(headPos.X, headPos.Y)
                            d.tracer.Color = Settings.ESPColor; d.tracer.Thickness = 1
                            d.tracer.Visible = Settings.ESPTracer

                            d.snapLine.From = Vector2.new(screenSize.X/2, 0)
                            d.snapLine.To   = Vector2.new(headPos.X, headPos.Y)
                            d.snapLine.Color = Settings.ESPColor; d.snapLine.Thickness = 1
                            d.snapLine.Visible = Settings.ESPSnapLine

                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then
                                d.weapon.Text = tool.Name
                                d.weapon.Position = Vector2.new(headPos.X, headPos.Y + height + 5)
                                d.weapon.Size = 12; d.weapon.Center = true; d.weapon.Outline = true
                                d.weapon.Color = Color3.fromRGB(255, 255, 0)
                                d.weapon.Visible = Settings.ESPWeapon
                            else
                                d.weapon.Visible = false
                            end

                            if Settings.ESPSkeleton then drawSkeleton(d, char, Settings.ESPColor)
                            else for _, l in ipairs(d.skeleton) do l.Visible = false end end
                        else
                            d.box.Visible = false; d.name.Visible = false; d.healthBg.Visible = false; d.health.Visible = false
                            d.dist.Visible = false; d.tracer.Visible = false; d.snapLine.Visible = false; d.weapon.Visible = false
                            for _, l in ipairs(d.skeleton) do l.Visible = false end
                        end
                    end
                end
            end
        end
    end
end

-- ============================================
-- SELF CHAMS
-- ============================================
local function destroySelfSpheres()
    for _, s in ipairs(SelfSpheres) do pcall(function() s:Destroy() end) end
    clearTable(SelfSpheres)
end

local function createSelfSpheres()
    destroySelfSpheres()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for i = 1, Settings.SelfCount do
        local sphere = Instance.new("Part")
        sphere.Name = "NurikWare_Sphere"
        sphere.Shape = Enum.PartType.Ball
        sphere.Size = Vector3.new(Settings.SelfSize, Settings.SelfSize, Settings.SelfSize)
        sphere.Color = Settings.SelfColor
        sphere.Material = (Settings.SelfMaterial == "Neon") and Enum.Material.Neon or Enum.Material.Glass
        sphere.Anchored = true; sphere.CanCollide = false; sphere.CastShadow = false
        sphere.Transparency = 0.1; sphere.Parent = workspace
        table.insert(SelfSpheres, sphere)
    end
end

local selfTime = 0
local function updateSelfSpheres(dt)
    if Unloaded or not Settings.SelfEnabled then
        if #SelfSpheres > 0 then destroySelfSpheres() end
        return
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if #SelfSpheres ~= Settings.SelfCount then createSelfSpheres(); return end
    
    selfTime = selfTime + dt * Settings.SelfSpeed
    local r = Settings.SelfRadius; local n = #SelfSpheres
    for i, s in ipairs(SelfSpheres) do
        if s.Parent then
            s.Color = Settings.SelfColor
            s.Material = (Settings.SelfMaterial == "Neon") and Enum.Material.Neon or Enum.Material.Glass
            s.Size = Vector3.new(Settings.SelfSize, Settings.SelfSize, Settings.SelfSize)
            local pos
            if Settings.SelfMode == "Orbit" then
                local angle = selfTime + (i * math.pi * 2 / n)
                pos = root.Position + Vector3.new(math.cos(angle)*r, 0, math.sin(angle)*r)
            elseif Settings.SelfMode == "Pulse" then
                local angle = (i * math.pi * 2 / n); local pulse = (math.sin(selfTime * 2) + 1) / 2
                pos = root.Position + Vector3.new(math.cos(angle)*r*pulse, 0, math.sin(angle)*r*pulse)
            elseif Settings.SelfMode == "Ring" then
                local angle = (i * math.pi * 2 / n)
                pos = root.Position + Vector3.new(math.cos(angle)*r, math.sin(selfTime*2)*0.5, math.sin(angle)*r)
            elseif Settings.SelfMode == "Spiral" then
                local angle = selfTime + (i * math.pi * 2 / n); local y = math.sin(selfTime * 2 + i) * r
                pos = root.Position + Vector3.new(math.cos(angle)*r, y, math.sin(angle)*r)
            end
            s.CFrame = CFrame.new(pos)
        end
    end
end

-- ============================================
-- KILL AURA (ВОЗВРАЩЕН CLOSEST/ALL)
-- ============================================
local function getAttackRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then
        local ok, res = pcall(function() return ReplicatedStorage:WaitForChild("Remotes", 1) end)
        remotes = ok and res or nil
    end
    if not remotes then return nil end
    return remotes:FindFirstChild("Attack")
end
local function getMyHRP()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then return char.HumanoidRootPart end
    return nil
end

local function getClosestPlayer(radius)
    local closest, closestDist = nil, math.huge
    local myHRP = getMyHRP()
    if not myHRP then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getPlayerCharacter(player)
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (myHRP.Position - hrp.Position).Magnitude
                if dist <= radius and dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

local function getAllPlayersInRadius(radius)
    local list = {}; local myHRP = getMyHRP()
    if not myHRP then return list end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getPlayerCharacter(player)
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if (myHRP.Position - hrp.Position).Magnitude <= radius then table.insert(list, player) end
            end
        end
    end
    return list
end

local function sendAttack(targetPlayer)
    if not targetPlayer then return end
    local now = os.clock()
    if Settings.KALastHit[targetPlayer] and (now - Settings.KALastHit[targetPlayer]) < Settings.KAPerTargetCD then return end
    
    local char = getPlayerCharacter(targetPlayer); if not char then return end
    local targetHRP = char:FindFirstChild("HumanoidRootPart"); local myHRP = getMyHRP()
    if not (targetHRP and myHRP) then return end
    
    local attackRemote = getAttackRemote(); if not attackRemote then return end
    local dir = (targetHRP.Position - myHRP.Position).Unit
    local eye = myHRP.Position + Vector3.new(0, 1.5, 0)
    
    Settings.KAPacketCounter = Settings.KAPacketCounter + 1
    local t = tick()
    local args = {
        [1] = char,
        [2] = {
            ["sprint"] = Settings.KASprint, ["charge"] = Settings.KACharge,
            ["dir"] = dir, ["vt"] = t, ["t"] = t, ["eye"] = eye, ["vs"] = t,
            ["crit"] = Settings.KACrit, ["n"] = Settings.KAPacketCounter,
        }
    }
    pcall(function() attackRemote:FireServer(unpack(args)) end)
    Settings.KALastHit[targetPlayer] = now
end

local function killAuraStep()
    if Unloaded or not Settings.KAEnabled then return end
    
    local targets = {}
    if Settings.KAMode == "Closest" then
        local closest = getClosestPlayer(Settings.KARadius)
        if closest then table.insert(targets, closest) end
    else
        targets = getAllPlayersInRadius(Settings.KARadius)
    end

    if #targets > 0 then
        for _, target in ipairs(targets) do sendAttack(target) end
    end
end
local function resetKillAura() Settings.KAPacketCounter = 5965; clearTable(Settings.KALastHit) end

-- ============================================
-- UNLOAD
-- ============================================
local function UnloadEverything()
    if Unloaded then return end
    Unloaded = true
    for _, c in ipairs(Connections) do safeDisconnect(c) end
    clearTable(Connections)
    for player, _ in pairs(CreatedHighlights) do removeESPFor(player) end
    for player, _ in pairs(CreatedDrawings) do removeESPFor(player) end
    destroySelfSpheres()
    
    Lighting.Brightness = OriginalLighting.Brightness
    Lighting.Ambient = OriginalLighting.Ambient
    Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
    Lighting.FogEnd = OriginalLighting.FogEnd
    Lighting.FogStart = OriginalLighting.FogStart
    Lighting.FogColor = OriginalLighting.FogColor
    Camera.FieldOfView = OriginalFOV
    local sky = Lighting:FindFirstChild("NurikWare_Sky")
    if sky then sky:Destroy() end
    for _, player in ipairs(Players:GetPlayers()) do
        local char = getPlayerCharacter(player)
        if char then
            local hl = char:FindFirstChild("NurikWare_Glow")
            if hl then hl:Destroy() end
        end
    end

    pcall(function() Rayfield:Destroy() end)
end

